{
  "name": "@local/dsh-status-notifier",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness bundle: shows agent status in the macOS menu bar via SwiftBar (pending approvals / running / finished tasks) with system notifications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Carlos5986515/dsh-status-notifier.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
